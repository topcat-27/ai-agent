FROM mcr.microsoft.com/playwright:v1.61.0-noble@sha256:57b65fdc9ceabe0ef613124c7bbe2babcf9362c4d85e382fe3b03604e84b428a

WORKDIR /tests

COPY tests/phase7/package.json tests/phase7/package-lock.json ./
RUN npm ci --ignore-scripts

COPY tests/phase7/browser-widths.mjs ./

USER pwuser

CMD ["node", "browser-widths.mjs"]
